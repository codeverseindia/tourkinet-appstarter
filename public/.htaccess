Options -Indexes
RewriteEngine On

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(?:env|ini|log|sql|bak|dist|json|lock|md)$">
    Require all denied
</FilesMatch>

RewriteRule ^index\.php$ - [L]
RewriteRule \.php$ - [F,L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
