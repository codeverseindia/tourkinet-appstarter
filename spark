#!/usr/bin/env php
<?php
declare(strict_types=1);

require __DIR__ . '/app/bootstrap.php';

$command = $argv[1] ?? 'help';
$options = array_slice($argv, 2);

function spark_help(): void
{
    echo "Travel Website CLI\n\n";
    echo "Commands:\n";
    echo "  help              Show this help message\n";
    echo "  serve             Start the local PHP development server\n";
    echo "    --host=HOST     Bind host (default: 127.0.0.1)\n";
    echo "    --port=PORT     Bind port (default: 8080)\n";
    echo "  routes            List configured application routes\n";
    echo "  cache:clear       Clear valid application cache files\n";
}

function spark_serve(array $options): never
{
    $host = '127.0.0.1';
    $port = '8080';
    foreach ($options as $option) {
        if (preg_match('/^--host=(.+)$/', $option, $match)) {
            $host = $match[1];
        } elseif (preg_match('/^--port=([0-9]{1,5})$/', $option, $match)) {
            $port = $match[1];
        } else {
            fwrite(STDERR, "Invalid serve option: {$option}\n");
            exit(2);
        }
    }
    if (filter_var($host, FILTER_VALIDATE_IP) === false || (int) $port < 1 || (int) $port > 65535) {
        fwrite(STDERR, "Invalid host or port. Host must be an IP address and port must be 1-65535.\n");
        exit(2);
    }
    $address = str_contains($host, ':') ? '[' . $host . ']' : $host;
    $command = [
        PHP_BINARY,
        '-S',
        $address . ':' . $port,
        '-t',
        PUBLIC_HTML_PATH,
        APP_PATH . '/dev-router.php',
    ];
    $escaped = implode(' ', array_map('escapeshellarg', $command));
    echo "Travel Website Development Server\n";
    echo "---------------------------------\n";
    echo 'PHP Version: ' . PHP_VERSION . "\n";
    echo "Environment: development\n\n";
    echo "Server running at:\nhttp://{$address}:{$port}\n\n";
    echo "Press Ctrl+C to stop.\n";
    passthru($escaped, $status);
    if ($status !== 0) {
        fwrite(STDERR, "Development server stopped with exit code {$status}.\n");
    }
    exit($status);
}

switch ($command) {
    case 'help':
        if ($options !== []) {
            fwrite(STDERR, "The help command does not accept options.\n");
            exit(2);
        }
        spark_help();
        break;
    case 'serve':
        spark_serve($options);
    case 'routes':
        if ($options !== []) {
            fwrite(STDERR, "The routes command does not accept options.\n");
            exit(2);
        }
        printf("%-8s %-24s %s\n", 'METHOD', 'URI', 'HANDLER');
        echo str_repeat('-', 58) . "\n";
        foreach (registered_routes() as $route) {
            printf("%-8s %-24s %s\n", $route['method'], $route['uri'], $route['handler']);
        }
        break;
    case 'cache:clear':
        if ($options !== []) {
            fwrite(STDERR, "The cache:clear command does not accept options.\n");
            exit(2);
        }
        if (!cache_clear()) {
            fwrite(STDERR, "Cache could not be cleared completely.\n");
            exit(1);
        }
        echo "Application cache cleared.\n";
        break;
    default:
        fwrite(STDERR, "Unknown command: {$command}\n\n");
        spark_help();
        exit(2);
}
