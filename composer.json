{
  "name": "codeverseindia/lightphp-app-starter",
  "description": "Minimal PHP application starter powered by LightPHP Core",
  "type": "project",
  "license": "proprietary",
  "require": {
    "ext-dom": "*",
    "php": "^8.5",
    "codeverseindia/lightphp-core": "^1.1",
    "codeverseindia/tourkinet-travel-app": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "serve": "@php spark serve",
    "routes": "@php spark routes",
    "cache-clear": "@php spark cache:clear",
    "test": "@php tests/run.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}