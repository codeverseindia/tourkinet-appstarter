APP_NAME="Travel Website"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Kolkata

TOURKINET_API_URL=https://api.tourkinet.com/api/v1
TOURKINET_API_KEY=
TOURKINET_CLIENT_DOMAIN=
# Set endpoint paths only after confirming the contracts for your account.
TOURKINET_PACKAGES_ENDPOINT=
TOURKINET_PACKAGE_ENDPOINT=
TOURKINET_BLOGS_ENDPOINT=
TOURKINET_BLOG_ENDPOINT=
TOURKINET_INQUIRY_ENDPOINT=

CACHE_ENABLED=true
CACHE_DEFAULT_TTL=900
CACHE_PACKAGES_TTL=900
CACHE_BLOGS_TTL=1800
CACHE_MAX_STALE=3600

WEBSITE_NAME="Travel Website"
WEBSITE_URL=http://127.0.0.1:8080
WEBSITE_LOGO=/assets/images/logo.svg
WEBSITE_EMAIL=hello@example.com
WEBSITE_PHONE=
WEBSITE_WHATSAPP=
META_TITLE="Discover your next journey"
META_DESCRIPTION="Thoughtfully planned tours and travel experiences."
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
